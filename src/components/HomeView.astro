---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import { categories } from "../data/categories";
import { links } from "../data/links";
import { linksByCategory } from "../data/links";
import CategorySection from "./CategorySection.astro";
import Hero from "./react/Hero";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);

const sections = categories.map((category, i) => ({
  category,
  links: linksByCategory(category.id),
  index: i + 1,
}));

const total = links.length;
---

<div class="mx-auto max-w-[1400px] px-5 sm:px-8">
  <Hero client:load locale={locale} total={total} />

  <!-- Categories overview -->
  <section id="categories" class="scroll-mt-20 pb-8">
    <div class="mb-8 flex items-end justify-between gap-6 border-b border-line pb-4">
      <div class="flex items-baseline gap-4">
        <span class="text-[11px] font-medium tracking-[0.2em] text-accent">00</span>
        <div>
          <h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
            {t("section.all")}
          </h2>
          <p class="mt-1 max-w-xl text-[12.5px] leading-relaxed text-muted">
            {t("section.allDesc")}
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        sections.map(({ category }) => (
          <a
            href={`#${category.slug}`}
            class="group inline-flex items-center gap-2 rounded-full border border-line px-3.5 py-1.5 text-[12px] tracking-tight text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/60 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent opacity-40 transition-opacity group-hover:opacity-100" />
            {category.name[locale]}
          </a>
        ))
      }
    </div>
  </section>

  <!-- All sections -->
  <div class="space-y-20 pb-8">
    {
      sections.map(({ category, links: catLinks, index }) => (
        <CategorySection
          category={category}
          links={catLinks}
          locale={locale}
          index={index}
          compact={true}
        />
      ))
    }
  </div>
</div>
