---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import { categories } from "../data/categories";
import { links } from "../data/links";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-[1400px] px-5 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2">
          <span
            class="grid h-6 w-6 place-items-center rounded bg-ink text-[11px] font-bold text-surface"
            aria-hidden="true">T</span
          >
          <span class="text-[13px] font-semibold tracking-tight text-ink"
            >{t("site.name")}</span
          >
        </div>
        <p class="mt-3 max-w-sm text-[12.5px] leading-relaxed text-muted">
          {t("site.tagline")}
        </p>
        <p class="mt-4 text-[11px] uppercase tracking-widest text-muted">
          {links.length} {t("stat.links")} · {categories.length}
          {t("stat.categories")}
        </p>
      </div>

      <div>
        <h3 class="text-[11px] uppercase tracking-widest text-muted">
          {t("footer.navigate")}
        </h3>
        <ul class="mt-3 space-y-1.5">
          {
            categories.map((c) => (
              <li>
                <a
                  href={`#${c.slug}`}
                  class="text-[12.5px] text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  {c.name[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-[11px] uppercase tracking-widest text-muted">
          {t("nav.explore")}
        </h3>
        <ul class="mt-3 space-y-1.5">
          <li>
            <button
              type="button"
              data-open-search
              class="text-[12.5px] text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t("nav.search")} <span class="text-[10px]">{t("nav.shortcut")}</span>
            </button>
          </li>
          <li>
            <a
              href={localePath(locale, "/")}
              class="text-[12.5px] text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t("nav.home")}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-[11px] text-muted">
        © {year} {t("site.name")} · {t("footer.rights")}
      </p>
      <p class="text-[11px] text-muted">{t("footer.note")}</p>
    </div>
  </div>
</footer>
