---
import type { Locale } from "../i18n/ui";
import { switchLocalePath } from "../i18n/path";
import MorphIcon from "morphicons/astro";
import { Globe } from "lucide";

interface Props {
  locale: Locale;
  label: string;
}
const { locale, label } = Astro.props;
const href = switchLocalePath(Astro.url.pathname, locale);
const nextLang = locale === "es" ? "EN" : "ES";
---

<a
  href={href}
  hreflang={locale === "es" ? "en" : "es"}
  aria-label={label}
  class="flex h-8 items-center gap-1.5 rounded-md px-1.5 text-muted transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <MorphIcon icon={Globe} size={14} strokeWidth={2} />
  <span data-lang-label class="text-[11px] font-medium uppercase tracking-widest"
    >{nextLang}</span
  >
</a>
