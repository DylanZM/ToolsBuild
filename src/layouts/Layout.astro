---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  locale?: "es" | "en";
}

const { title, description, locale = "es" } = Astro.props;
const ogLocale = locale === "es" ? "es_ES" : "en_US";
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="theme-color" content="#07080a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://image.thum.io" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function apply() {
          try {
            var stored = localStorage.getItem("theme");
            var theme = stored === "light" ? "light" : "dark";
            document.documentElement.classList.toggle("dark", theme === "dark");
            document.documentElement.style.colorScheme = theme;
          } catch (e) {}
          try {
            var view = localStorage.getItem("view");
            document.documentElement.dataset.view =
              view === "list" ? "list" : "grid";
          } catch (e) {
            document.documentElement.dataset.view = "grid";
          }
          try {
            var rail = localStorage.getItem("sidebar");
            document.documentElement.dataset.sidebarCollapsed =
              rail === "hidden" ? "true" : "false";
          } catch (e) {
            document.documentElement.dataset.sidebarCollapsed = "false";
          }
        }
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
