---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import { categories } from "../data/categories";
import { linksByCategory } from "../data/links";

interface Props {
  locale: Locale;
  activeSlug?: string;
}
const { locale, activeSlug } = Astro.props;
const t = createT(locale);
---

<nav aria-label={t("nav.categories")} class="lg:sticky lg:top-20">
  <p class="mb-3 text-[10px] uppercase tracking-[0.2em] text-muted">
    {t("nav.categories")}
  </p>
  <ul class="flex flex-wrap gap-2 lg:flex-col lg:gap-0.5">
    {
      categories.map((c, i) => {
        const active = c.slug === activeSlug;
        const count = linksByCategory(c.id).length;
        return (
          <li>
            <a
              href={localePath(locale, `/${c.slug}`)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "group flex items-center justify-between gap-3 rounded-md px-2.5 py-1.5 text-[12.5px] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                active
                  ? "bg-ink text-surface"
                  : "text-muted hover:bg-surface-2 hover:text-ink",
              ]}
            >
              <span class="flex items-center gap-2.5">
                <span
                  class:list={[
                    "text-[10px] tracking-wider",
                    active ? "text-accent" : "text-muted",
                  ]}
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="truncate tracking-tight">{c.name[locale]}</span>
              </span>
              <span
                class:list={[
                  "text-[10px] tabular-nums",
                  active ? "text-surface/70" : "text-muted",
                ]}>{count}</span
              >
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
