---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
const base = localePath(locale, "/");
const ghProfile = "https://github.com/DylanZM";
const ghRepo = "https://github.com/DylanZM/ToolsBuild";
---

<footer class="mt-16 border-t border-line">
  <div
    class="mx-auto grid max-w-[1360px] grid-cols-1 gap-[18px] px-5 py-10 sm:px-8 md:min-h-[130px] md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-6 md:px-10 md:py-[30px]"
  >
    <a
      href={base}
      class="w-fit opacity-70 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:justify-self-start"
    >
      <Logo name={t("site.name")} />
    </a>

    <div class="md:text-center">
      <p class="mb-[3px] text-[13px] text-muted">
        <span>{t("footer.projectBy")}</span>
        <a
          href={ghProfile}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1.5 inline-flex items-center gap-1.5 text-ink underline underline-offset-[3px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="shrink-0"
            ><path
              d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
            ></path></svg
          >
          DylanZM
          <span class="text-accent">↗</span>
        </a>
      </p>
      <p class="text-[12.5px] text-muted">{t("footer.note")}</p>
    </div>

    <nav
      class="flex flex-wrap gap-[7px] md:justify-self-end"
      aria-label={t("footer.links")}
    >
      <a
        href={ghProfile}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-[3px] border border-line px-[9px] py-[7px] text-[12.5px] text-muted transition-colors hover:border-ink/25 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        GitHub <span class="text-accent">↗</span>
      </a>
      <a
        href={ghRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-[3px] border border-line px-[9px] py-[7px] text-[12.5px] text-muted transition-colors hover:border-ink/25 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Open source <span class="text-accent">↗</span>
      </a>
    </nav>
  </div>
</footer>
