---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import NavIcon from "./NavIcon.astro";

export interface NavItem {
  slug: string;
  name: string;
  count: number;
  active: boolean;
  icon: [string, Record<string, string>][];
}

interface Props {
  locale: Locale;
  items: NavItem[];
}
const { locale, items } = Astro.props;
const t = createT(locale);
---

<aside
  aria-label={t("nav.categories")}
  class="hidden lg:sticky lg:top-[76px] lg:block lg:self-start"
>
  <p
    class="mb-3.5 pl-3.5 text-[11px] font-medium uppercase tracking-[0.16em] text-muted"
  >
    {t("nav.categories")}
  </p>
  <ul class="space-y-px">
    {
      items.map((item) => (
        <li>
          <a
            href={
              item.slug
                ? localePath(locale, `/${item.slug}`)
                : localePath(locale, "/")
            }
            data-nav-link
            data-active={item.active ? "true" : "false"}
            aria-current={item.active ? "page" : undefined}
            class="grid min-h-[42px] grid-cols-[24px_minmax(0,1fr)_auto] items-center gap-2 border-l border-line pl-3.5 pr-3 text-[12.5px] text-muted transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <NavIcon icon={item.icon} size={15} class="nav-icon shrink-0 opacity-60" />
            <span class="truncate font-display font-medium tracking-tight">
              {item.name}
            </span>
            <small class="nav-count text-[10.5px] tabular-nums opacity-70">
              {item.count}
            </small>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
