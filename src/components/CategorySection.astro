---
import type { Locale } from "../i18n/ui";
import type { Category } from "../data/categories";
import type { Link } from "../data/links";
import ResourceCard from "./ResourceCard.astro";
import CategoryHeader from "./CategoryHeader.astro";

interface Props {
  category: Category;
  links: Link[];
  locale: Locale;
  index?: number;
  /** Draw the top rule + spacing (landing sections). Off on category pages. */
  showRule?: boolean;
  heading?: "h1" | "h2";
  /** Skip the built-in header (category pages render it in Shell's top slot). */
  hideHeader?: boolean;
}

const {
  category,
  links,
  locale,
  index = 1,
  showRule = true,
  heading = "h2",
  hideHeader = false,
} = Astro.props;
---

<section
  id={category.slug}
  class:list={[
    "scroll-mt-24",
    showRule && "border-t border-line pt-8 sm:pt-12 lg:pt-16",
  ]}
>
  {!hideHeader && (
    <CategoryHeader
      category={category}
      locale={locale}
      index={index}
      count={links.length}
      heading={heading}
    />
  )}

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" data-card-grid>
    {
      links.map((link, i) => (
        <ResourceCard link={link} locale={locale} index={i} />
      ))
    }
  </div>
</section>
