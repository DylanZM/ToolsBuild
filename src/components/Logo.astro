---
interface Props {
  name: string;
  wordmark?: boolean;
  size?: number;
}
const { name, wordmark = true, size = 22 } = Astro.props;
---

<span class="inline-flex items-center gap-2">
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    aria-hidden="true"
    class="shrink-0 transition-transform duration-300 ease-out-expo group-hover:rotate-90"
  >
    <path fill="var(--accent)" d="M12 1 21.53 6.5v11L12 23 2.47 17.5v-11L12 1Z"></path>
    <path fill="var(--surface)" d="M6.5 6.6h11v3.6h-4v7.4h-3v-7.4h-4V6.6Z"></path>
  </svg>
  {
    wordmark && (
      <span class="text-[13px] font-semibold tracking-tight text-ink">{name}</span>
    )
  }
</span>
