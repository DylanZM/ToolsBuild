---
import type { Locale } from "../i18n/ui";
import { links } from "../data/links";
import ResourceCard from "./ResourceCard.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  id="recursos"
  data-card-grid
  data-filter-grid
  class="grid scroll-mt-24 grid-cols-1 gap-3 pb-6 transition-opacity duration-200 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
>
  {
    links.map((link, i) => (
      <ResourceCard link={link} locale={locale} index={i} />
    ))
  }
</div>
