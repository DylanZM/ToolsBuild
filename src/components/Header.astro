---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";
import MorphIcon from "morphicons/astro";
import { Grid2X2, List, Search } from "lucide";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
---

<header
  class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur-md"
>
  <div class="flex h-14 items-center gap-3 px-5 sm:px-8">
    <button
      type="button"
      data-sidebar-open
      data-tooltip={t("nav.menu")}
      data-tooltip-align="start"
      data-tip-menu={t("nav.menu")}
      data-tip-hide={t("nav.hideSidebar")}
      data-tip-show={t("nav.showSidebar")}
      aria-label={t("nav.menu")}
      aria-controls="sidebar"
      aria-expanded="true"
      class="grid h-8 w-8 shrink-0 place-items-center rounded-md text-muted transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        ><path d="M4 6h16"></path><path d="M4 12h16"></path><path
          d="M4 18h16"
        ></path></svg
      >
    </button>

    <a
      href={localePath(locale, "/")}
      class="group flex shrink-0 items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      <Logo name={t("site.name")} />
    </a>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      <button
        type="button"
        data-open-search
        data-tooltip={t("tooltip.search")}
        class="flex h-8 items-center gap-1.5 rounded-md px-1.5 text-muted transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={t("nav.search")}
      >
        <MorphIcon icon={Search} size={14} strokeWidth={2} />
        <kbd
          data-shortcut-mod
          class="hidden rounded border border-line px-1 py-px text-[10px] font-medium tracking-wider text-muted sm:inline"
          >Ctrl</kbd
        >
        <kbd
          class="hidden rounded border border-line px-1 py-px text-[10px] font-medium tracking-wider text-muted sm:inline"
          >K</kbd
        >
      </button>

      <LangSwitch locale={locale} label={t("lang.switch")} />
      <button
        type="button"
        data-view-toggle
        data-label-grid={t("view.grid")}
        data-label-list={t("view.list")}
        data-tooltip={t("tooltip.viewToList")}
        data-tip-to-list={t("tooltip.viewToList")}
        data-tip-to-grid={t("tooltip.viewToGrid")}
        aria-label={t("view.list")}
        aria-pressed="true"
        class="hidden h-8 w-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent lg:grid"
      >
        <MorphIcon icon={Grid2X2} size={14} strokeWidth={2} />
      </button>

      <ThemeToggle
        label={t("theme.toggle")}
        tipLight={t("tooltip.themeToLight")}
        tipDark={t("tooltip.themeToDark")}
      />
    </div>
  </div>
</header>

<script>
  import { Grid2X2, List } from "lucide";
  import { setIcon } from "../lib/morph";

  function applyView(view: string, animate = false) {
    const isGrid = view !== "list";
    document.documentElement.dataset.view = isGrid ? "grid" : "list";
    document.querySelectorAll<HTMLButtonElement>("[data-view-toggle]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(isGrid));
      const label = isGrid ? btn.dataset.labelList : btn.dataset.labelGrid;
      if (label) btn.setAttribute("aria-label", label);
      const tip = isGrid ? btn.dataset.tipToList : btn.dataset.tipToGrid;
      if (tip) btn.setAttribute("data-tooltip", tip);
      setIcon(btn, isGrid ? Grid2X2 : List, animate);
    });
  }

  /**
   * Fades the cards out, swaps the layout, then fades them back in, so the
   * view change reads as resources leaving and returning (not a reload).
   */
  let switching = false;

  async function switchView(view: string) {
    if (switching) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      applyView(view, false);
      return;
    }

    switching = true;
    try {
      const visible = Array.from(document.querySelectorAll<HTMLElement>("[data-card]")).filter((card) => {
        const r = card.getBoundingClientRect();
        return r.bottom > -160 && r.top < window.innerHeight + 160;
      });

      await Promise.allSettled(
        visible.map((card) =>
          card
            .animate(
              [
                { opacity: 1, transform: "none" },
                { opacity: 0, transform: "translateY(-10px) scale(0.985)" },
              ],
              { duration: 170, easing: "cubic-bezier(0.4, 0, 1, 1)", fill: "forwards" },
            ).finished,
        ),
      );

      applyView(view, true);

      visible.forEach((card, i) => {
        card.getAnimations().forEach((a) => a.cancel());
        card.animate(
          [
            { opacity: 0, transform: "translateY(10px) scale(0.985)" },
            { opacity: 1, transform: "none" },
          ],
          {
            duration: 340,
            delay: Math.min(i, 8) * 18,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          },
        );
      });
    } finally {
      switching = false;
    }
  }

  function bind() {
    document.querySelectorAll<HTMLElement>("[data-open-search]").forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = "1";
      el.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toolsbuild:search"));
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-view-toggle]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const view = document.documentElement.dataset.view === "list" ? "grid" : "list";
        switchView(view);
        try {
          localStorage.setItem("view", view);
        } catch {}
      });
    });

    applyView(document.documentElement.dataset.view || "grid");

    if (/Mac|iPhone|iPad|iPod/.test(navigator.platform || "")) {
      document.querySelectorAll("[data-shortcut-mod]").forEach((kbd) => {
        kbd.textContent = "⌘";
      });
    }
  }
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
