---
import Shell from "../../components/Shell.astro";
import CategorySection from "../../components/CategorySection.astro";
import { categories, getCategory } from "../../data/categories";
import { linksByCategory } from "../../data/links";
import { createT } from "../../i18n/ui";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const locale = "en" as const;
const t = createT(locale);

const category = getCategory(Astro.params.category ?? "");
if (!category) throw new Error(`Unknown category: ${Astro.params.category}`);

const index = categories.findIndex((c) => c.id === category.id) + 1;
---

<Shell
  title={`${category.name[locale]} — ${t("site.name")}`}
  description={category.desc[locale]}
  locale={locale}
  sidebarPad="lg:pt-8"
>
  <div class="mx-auto max-w-[1360px] px-5 pb-8 pt-6 sm:px-8 sm:pt-8">
    <CategorySection
      category={category}
      links={linksByCategory(category.id)}
      locale={locale}
      index={index}
      showRule={false}
      heading="h1"
    />
  </div>
</Shell>
