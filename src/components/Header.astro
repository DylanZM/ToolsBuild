---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
---

<header
  class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur-md"
>
  <div class="flex h-14 items-center gap-3 px-5 sm:px-8">
    <button
      type="button"
      data-sidebar-open
      aria-label={t("nav.menu")}
      aria-controls="sidebar"
      aria-expanded="false"
      class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-line text-muted transition-colors hover:border-accent/50 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent lg:hidden"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        ><path d="M4 6h16"></path><path d="M4 12h16"></path><path
          d="M4 18h16"
        ></path></svg
      >
    </button>

    <a
      href={localePath(locale, "/")}
      class="group flex shrink-0 items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent lg:hidden"
    >
      <Logo name={t("site.name")} />
    </a>

    <div class="hidden min-w-0 items-baseline gap-2.5 lg:flex" aria-live="polite">
      <span
        data-header-num
        class="font-mono text-[11px] tabular-nums tracking-[0.2em] text-accent"></span>
      <span
        data-header-name
        class="truncate text-[13px] font-medium tracking-tight text-ink"
        >{t("nav.home")}</span
      >
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <div
        class="hidden shrink-0 items-center gap-1 lg:flex"
        role="group"
        aria-label={t("view.label")}
      >
        <button
          type="button"
          data-view-set="grid"
          aria-label={t("view.grid")}
          aria-pressed="true"
          class="grid h-7 w-7 place-items-center rounded-md border border-line text-muted transition-colors hover:border-accent/50 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect
              x="14"
              y="3"
              width="7"
              height="7"
              rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"
            ></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg
          >
        </button>
        <button
          type="button"
          data-view-set="list"
          aria-label={t("view.list")}
          aria-pressed="false"
          class="grid h-7 w-7 place-items-center rounded-md border border-line text-muted transition-colors hover:border-accent/50 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            ><path d="M8 6h13M8 12h13M8 18h13"></path><path
              d="M3 6h.01M3 12h.01M3 18h.01"></path></svg
          >
        </button>
      </div>

      <button
        type="button"
        data-open-search
        class="group flex h-8 items-center gap-2 rounded-md border border-line px-2.5 text-[12px] text-muted transition-colors hover:border-accent/50 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={t("nav.search")}
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="8"></circle><path
            d="m21 21-4.3-4.3"></path></svg
        >
        <span class="hidden sm:inline">{t("nav.searchHint")}</span>
        <kbd
          data-shortcut
          class="hidden rounded border border-line px-1 py-px font-mono text-[10px] font-medium tracking-wider text-muted sm:inline"
          >{t("nav.shortcut")}</kbd
        >
      </button>

      <LangSwitch locale={locale} label={t("lang.switch")} />
      <ThemeToggle label={t("theme.toggle")} />
    </div>
  </div>
</header>

<script>
  function applyView(view: string) {
    document.documentElement.dataset.view = view;
    document.querySelectorAll<HTMLButtonElement>("[data-view-set]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.viewSet === view));
    });
  }

  function bind() {
    document.querySelectorAll<HTMLElement>("[data-open-search]").forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = "1";
      el.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toolsbuild:search"));
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-view-set]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const view = btn.dataset.viewSet === "list" ? "list" : "grid";
        applyView(view);
        try {
          localStorage.setItem("view", view);
        } catch {}
      });
    });

    applyView(document.documentElement.dataset.view || "grid");

    if (/Mac|iPhone|iPad|iPod/.test(navigator.platform || "")) {
      document.querySelectorAll("[data-shortcut]").forEach((kbd) => {
        kbd.textContent = "⌘ K";
      });
    }
  }
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
