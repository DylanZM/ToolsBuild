---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { switchLocalePath } from "../i18n/path";

interface Props {
  title: string;
  description: string;
  locale?: "es" | "en";
}

const { title, description, locale = "es" } = Astro.props;
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const site = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, site);
const alternatePath = switchLocalePath(Astro.url.pathname, locale);
const alternateURL = new URL(alternatePath, site);
const ogImage = new URL("/preview.png", site);
const verification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ||
  "n3R4paaq_J78lftKsIYupsOuSktP2hXKwE7srkkuZ34";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Toolsbuild",
  alternateName: "Tools Build",
  url: site.toString(),
  description,
  inLanguage: locale,
  publisher: {
    "@type": "Organization",
    name: "Toolsbuild",
    url: site.toString(),
    logo: new URL("/favicon.svg", site).toString(),
  },
};
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={locale === "es" ? canonicalURL : alternateURL} />
    <link rel="alternate" hreflang="en" href={locale === "en" ? canonicalURL : alternateURL} />
    <link rel="alternate" hreflang="x-default" href={locale === "es" ? canonicalURL : alternateURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta property="og:site_name" content="Toolsbuild" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2880" />
    <meta property="og:image:height" content="1800" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#07080a" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://image.thum.io" crossorigin />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      (function () {
        function apply() {
          try {
            var stored = localStorage.getItem("theme");
            var theme = stored === "light" ? "light" : "dark";
            document.documentElement.classList.toggle("dark", theme === "dark");
            document.documentElement.style.colorScheme = theme;
          } catch (e) {}
          try {
            var view = localStorage.getItem("view");
            document.documentElement.dataset.view =
              view === "list" ? "list" : "grid";
          } catch (e) {
            document.documentElement.dataset.view = "grid";
          }
        }
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
