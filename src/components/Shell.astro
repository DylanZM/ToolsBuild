---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SearchPalette from "./react/SearchPalette";
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { links } from "../data/links";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = createT(locale);

const searchItems = links.map((l) => ({
  id: l.id,
  url: l.url,
  name: l.name,
  category: l.category,
  desc: l.desc[locale],
  tags: l.tags,
}));
---

<Layout title={title} description={description} locale={locale}>
  <Header locale={locale} />
  <slot />
  <Footer locale={locale} />
  <SearchPalette client:load items={searchItems} locale={locale} />
</Layout>
