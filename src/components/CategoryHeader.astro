---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import type { Category } from "../data/categories";

interface Props {
  category: Category;
  locale: Locale;
  index: number;
  count: number;
  heading?: "h1" | "h2";
}
const { category, locale, index, count, heading = "h2" } = Astro.props;
const t = createT(locale);
const num = String(index).padStart(2, "0");
const Heading = heading;
const isPageHeading = heading === "h1";
---

<div
  class="mb-6 flex items-end justify-between gap-6 border-b border-line pb-4"
>
  <div class="flex items-baseline gap-4">
    <span
      class="text-[11px] font-medium uppercase tracking-[0.2em] text-accent tabular-nums"
      >{num}</span
    >
    <div>
      <Heading
        class:list={[
          "font-semibold tracking-tight text-ink",
          isPageHeading ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
        ]}
      >
        {category.name[locale]}
      </Heading>
      <p class="mt-1 max-w-[72ch] text-[12.5px] leading-relaxed text-muted">
        {category.desc[locale]}
      </p>
    </div>
  </div>
  <span
    class="hidden shrink-0 text-[11px] uppercase tracking-widest text-muted sm:block"
  >
    {count} {t("section.items")}
  </span>
</div>
