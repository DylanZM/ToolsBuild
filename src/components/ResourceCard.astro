---
import type { Link } from "../data/links";
import { faviconUrl, domainOf } from "../lib/url";
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";

interface Props {
  link: Link;
  locale: Locale;
  index?: number;
}

const { link, locale, index = 0 } = Astro.props;
const t = createT(locale);
const href = link.url;
const isNew =
  link.addedAt !== undefined &&
  Number.isFinite(Date.parse(link.addedAt)) &&
  Date.now() - Date.parse(link.addedAt) < 7 * 24 * 60 * 60 * 1000;
const favLabel = locale === "en" ? "Save to favorites" : "Guardar en favoritos";
---

<div
  class="group relative flex flex-col gap-3 rounded-xl bg-surface-2 p-4 transition-transform duration-300 ease-out-expo hover:-translate-y-0.5 sm:p-5"
  data-card
  data-category={link.category}
  data-search-item
  data-preview-url={href}
  data-preview-name={link.name}
  data-name={link.name.toLowerCase()}
  data-desc={link.desc[locale].toLowerCase()}
  data-tags={link.tags.join(" ").toLowerCase()}
>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-0 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    aria-label={link.name}
  >
  </a>

  {
    isNew && (
      <span
        class="pointer-events-none absolute -left-1.5 -top-1 z-10 rotate-[-10deg] rounded-md border border-accent/30 bg-accent-soft px-2 py-[2px] text-[10px] font-semibold leading-none tracking-tight text-accent"
        data-card-new
      >
        {locale === "en" ? "New" : "Nuevo"}
      </span>
    )
  }

  <div class="pointer-events-none relative z-10 flex items-start justify-between gap-2" data-card-head>
    <div class="flex min-w-0 items-center gap-3">
      <img
        src={faviconUrl(link.url)}
        alt=""
        width="20"
        height="20"
        loading="lazy"
        decoding="async"
        class="h-5 w-5 shrink-0 object-contain"
        data-favicon
        data-fallback={domainOf(link.url).charAt(0).toUpperCase()}
        onerror="this.outerHTML='<span class=&quot;grid h-5 w-5 shrink-0 place-items-center text-[11px] font-medium text-muted&quot;>' + this.dataset.fallback + '</span>'"
      />
      <div class="min-w-0">
        <h3
          class="truncate text-[13px] font-medium tracking-tight text-ink transition-colors"
        >
          {link.name}
        </h3>
        <p class="truncate text-[11px] text-muted">{domainOf(link.url)}</p>
      </div>
    </div>
    <div class="flex min-w-0 shrink-0 items-center gap-0.5">
      <span
        aria-hidden="true"
        class="mt-1 shrink-0 text-muted opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0 group-hover:opacity-100 -translate-x-1"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
        >
      </span>
      <button
        type="button"
        data-favorite-toggle
        data-favorite-id={link.id}
        data-favorite-url={href}
        data-favorite-name={link.name}
        data-favorite-desc={link.desc[locale]}
        data-favorite-category={link.category}
        data-favorite-label={favLabel}
        aria-label={favLabel}
        title={favLabel}
        aria-pressed="false"
        class="pointer-events-auto grid h-7 w-7 shrink-0 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent data-[favorite=true]:text-accent"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M12 2.75l2.9 5.88 6.49.95-4.7 4.58 1.11 6.47L12 17.58l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.95L12 2.75z"
          ></path></svg
        >
      </button>
    </div>
  </div>

  <p
    class="pointer-events-none relative z-10 text-[12.5px] leading-relaxed text-muted line-clamp-2"
    data-card-desc
  >
    {link.desc[locale]}
  </p>

  {
    link.tags.length > 0 && (
      <div
        class="pointer-events-none relative z-10 mt-auto flex flex-wrap gap-1.5 pt-1"
        data-card-tags
      >
        {link.tags.slice(0, 3).map((tag) => (
          <span class="rounded-md bg-surface px-2 py-0.5 text-[10.5px] font-medium leading-[1.5] tracking-tight text-muted transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>

<script>
  import { FAVORITES_KEY, MAX_FAVORITES } from "../lib/favorites";

  interface FavoriteStoreItem {
    id: string;
    url: string;
    name: string;
    desc?: string;
    category?: string;
  }

  const read = (): FavoriteStoreItem[] => {
    try {
      const parsed = JSON.parse(localStorage.getItem(FAVORITES_KEY) || "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const write = (list: FavoriteStoreItem[]) => {
    try {
      localStorage.setItem(
        FAVORITES_KEY,
        JSON.stringify(list.slice(0, MAX_FAVORITES)),
      );
    } catch {}
  };

  const paint = (button: HTMLButtonElement, active: boolean) => {
    const label = button.dataset.favoriteLabel || "";
    button.dataset.favorite = active ? "true" : "false";
    button.setAttribute("aria-pressed", active ? "true" : "false");
    button.setAttribute("aria-label", active ? label + " ✓" : label);
    const svg = button.querySelector("svg");
    if (svg) svg.setAttribute("fill", active ? "currentColor" : "none");
  };

  const syncAll = () => {
    const ids = new Set(read().map((item) => item.id));
    document
      .querySelectorAll<HTMLButtonElement>("[data-favorite-toggle]")
      .forEach((button) => {
        paint(button, ids.has(button.dataset.favoriteId || ""));
      });
  };

  syncAll();

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
      "[data-favorite-toggle]",
    );
    if (!button) return;
    event.preventDefault();
    event.stopPropagation();

    const id = button.dataset.favoriteId;
    if (!id) return;

    const current = read();
    const exists = current.some((item) => item.id === id);
    const next = exists
      ? current.filter((item) => item.id !== id)
      : [
          {
            id,
            url: button.dataset.favoriteUrl || "",
            name: button.dataset.favoriteName || "",
            desc: button.dataset.favoriteDesc,
            category: button.dataset.favoriteCategory,
          },
          ...current,
        ].slice(0, MAX_FAVORITES);

    write(next);
    paint(button, !exists);
    window.dispatchEvent(
      new CustomEvent("toolsbuild:favorites-sync", { detail: { id } }),
    );
  });
</script>
