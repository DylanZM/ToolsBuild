---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
const year = new Date().getFullYear();
const base = localePath(locale, "/");
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto max-w-[1360px] px-5 sm:px-8">
    <div class="max-w-[42ch] py-12">
      <a
        href={base}
        class="inline-flex focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        <Logo name={t("site.name")} />
      </a>
      <p class="mt-4 text-[13px] leading-relaxed text-muted">
        {t("site.description")}
      </p>
    </div>

    <div
      class="flex flex-col gap-2 border-t border-line py-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-[11.5px] text-muted">
        © {year} {t("site.name")} · {t("footer.rights")}
      </p>
      <p class="text-[11.5px] text-muted">{t("footer.note")}</p>
    </div>
  </div>
</footer>
