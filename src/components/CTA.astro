---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = createT(locale);
const ghRepo = "https://github.com/DylanZM/ToolsBuild";
const ghIssues = `${ghRepo}/issues/new`;
---

<section
  class="relative mt-2 overflow-hidden rounded-2xl border border-line bg-surface px-6 py-12 text-center sm:px-10 sm:py-14"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 -top-36 h-64 w-[40rem] max-w-full -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--accent-soft),transparent)]"
  >
  </div>
  <h2
    class="relative text-balance text-2xl font-semibold tracking-[-0.03em] text-ink sm:text-[1.75rem]"
  >
    {t("cta.title")}
  </h2>
  <p
    class="relative mx-auto mt-3 max-w-[48ch] text-[13.5px] leading-relaxed text-muted"
  >
    {t("cta.text")}
  </p>
  <div class="relative mt-6 flex flex-wrap items-center justify-center gap-2.5">
    <a
      href={ghIssues}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-md bg-accent px-4 py-2 text-[13px] font-semibold text-accent-ink transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t("cta.primary")}
      <span aria-hidden="true">↗</span>
    </a>
    <a
      href={ghRepo}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-md border border-line px-4 py-2 text-[13px] font-medium text-muted transition-colors hover:border-ink/30 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t("cta.secondary")}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <p class="relative mt-4 text-[11.5px] text-muted">{t("cta.note")}</p>
</section>
