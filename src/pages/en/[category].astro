---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryView from "../../components/CategoryView.astro";
import { categories } from "../../data/categories";
import { createT } from "../../i18n/ui";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
  }));
}

const locale = "en" as const;
const t = createT(locale);
const { category } = Astro.params;
const cat = categories.find((c) => c.slug === category)!;

const title = `${cat.name[locale]} — ${t("site.name")}`;
---

<Layout title={title} description={cat.desc[locale]} locale={locale}>
  <Header locale={locale} />
  <CategoryView locale={locale} activeSlug={cat.slug} />
  <Footer locale={locale} />
</Layout>
