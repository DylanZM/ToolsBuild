---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Sidebar from "./Sidebar.astro";
import SearchPalette from "./react/SearchPalette";
import HoverPreview from "./react/HoverPreview";
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { links } from "../data/links";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** lg top padding of the sidebar so it lines up with the page content. */
  sidebarPad?: string;
}

const { locale, title, description, sidebarPad = "lg:pt-20" } = Astro.props;
const t = createT(locale);

const searchItems = links.map((l) => ({
  id: l.id,
  url: l.url,
  name: l.name,
  category: l.category,
  desc: l.desc[locale],
  tags: l.tags,
}));
---

<Layout title={title} description={description} locale={locale}>
  <div
    data-sidebar-backdrop
    class="pointer-events-none fixed inset-0 z-40 bg-surface/70 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></div>

  <Header locale={locale} />

  <div class="shell-grid lg:grid lg:grid-cols-[240px_minmax(0,1fr)]">
    <Sidebar locale={locale} pad={sidebarPad} />
    <div class="min-w-0">
      <slot />
      <Footer locale={locale} />
    </div>
  </div>

  <SearchPalette client:load items={searchItems} locale={locale} />
  <HoverPreview client:load />
</Layout>
