---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import type { Category } from "../data/categories";
import type { Link } from "../data/links";
import ResourceCard from "./ResourceCard.astro";

interface Props {
  category: Category;
  links: Link[];
  locale: Locale;
  index?: number;
}

const { category, links, locale, index = 1 } = Astro.props;
const t = createT(locale);
const num = String(index).padStart(2, "0");
---

<section id={category.slug} data-spy-section data-name={category.name[locale]} data-num={num} class="scroll-mt-24">
  <div class="mb-6 flex items-end justify-between gap-6 border-b border-line pb-4">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-[11px] font-medium tracking-[0.2em] text-accent tabular-nums"
        >{num}</span
      >
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
          {category.name[locale]}
        </h2>
        <p class="mt-1 max-w-[72ch] text-[12.5px] leading-relaxed text-muted">
          {category.desc[locale]}
        </p>
      </div>
    </div>
    <span class="hidden shrink-0 font-mono text-[11px] uppercase tracking-widest text-muted sm:block">
      {links.length} {t("section.items")}
    </span>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
    {
      links.map((link, i) => (
        <ResourceCard link={link} locale={locale} index={i} />
      ))
    }
  </div>
</section>
