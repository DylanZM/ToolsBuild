---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import AdminPanel from "../components/react/AdminPanel";
import { links } from "../data/links";
import { categories } from "../data/categories";

const cats = [...categories]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ id: c.id, name: c.name.es }));
---

<Layout
  title="Panel — Toolsbuild"
  description="Panel local para gestionar los recursos del directorio."
>
  <meta slot="head" name="robots" content="noindex" />
  <header
    class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur-md"
  >
    <div class="flex h-14 items-center justify-between px-5 sm:px-8">
      <a
        href="/"
        class="inline-flex focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        <Logo name="Toolsbuild" />
      </a>
      <span class="text-[11.5px] text-muted">src/data/links.json</span>
    </div>
  </header>

  <AdminPanel
    client:load
    links={links}
    categories={cats}
    dev={import.meta.env.DEV}
  />
</Layout>
