---
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { localePath } from "../i18n/path";
import NavIcon from "./NavIcon.astro";
import Logo from "./Logo.astro";
import { categories } from "../data/categories";

export interface NavItem {
  slug: string;
  name: string;
  count: number;
  active: boolean;
}

interface Props {
  locale: Locale;
  items: NavItem[];
}
const { locale, items } = Astro.props;
const t = createT(locale);
const base = localePath(locale, "/");
const hrefFor = (slug: string) => (slug === "all" ? base : `${base}#${slug}`);

const descs: Record<string, string> = {
  all: t("site.description"),
  ...Object.fromEntries(categories.map((c) => [c.slug, c.desc[locale]])),
};
---

<aside
  id="sidebar"
  data-sidebar
  inert
  aria-label={t("nav.categories")}
  class="invisible fixed inset-y-0 left-0 z-50 flex w-[276px] -translate-x-full flex-col bg-surface transition-[transform,visibility] duration-300 ease-out-expo lg:visible lg:sticky lg:top-[57px] lg:bottom-auto lg:left-auto lg:z-30 lg:max-h-[calc(100vh-57px)] lg:w-auto lg:translate-x-0 lg:self-start"
>
  <div class="flex h-14 shrink-0 items-center justify-between gap-3 px-5 lg:hidden">
    <a
      href={base}
      class="group flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      <Logo name={t("site.name")} />
    </a>

    <button
      type="button"
      data-sidebar-close
      aria-label={t("nav.close")}
      class="grid h-8 w-8 place-items-center rounded-md text-muted transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
      >
    </button>
  </div>

  <nav
    data-sidebar-nav
    data-descs={JSON.stringify(descs)}
    class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 py-4"
    aria-label={t("nav.categories")}
  >
    <p
      class="px-2 pt-5 pb-2.5 font-sans text-[12px] font-medium tracking-tight text-muted"
    >
      {t("nav.categories")}
    </p>

    <ul class="space-y-1">
      {
        items.map((item) => (
          <li>
            <a
              href={hrefFor(item.slug)}
              data-nav-link
              data-filter-link={item.slug}
              data-active={item.active ? "true" : "false"}
              aria-current={item.active ? "page" : undefined}
              class="group flex items-center justify-between gap-3 rounded-md px-2 py-2 transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span class="flex min-w-0 items-center gap-2.5">
                <NavIcon
                  name={item.slug}
                  size={14}
                  class="nav-icon shrink-0 opacity-55"
                />
                <span class="truncate font-display text-[13px] font-medium tracking-tight">
                  {item.name}
                </span>
              </span>
              <span class="nav-count shrink-0 text-[11px] tabular-nums opacity-70">
                {item.count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p
      data-active-desc
      class="mt-4 px-2 text-[11.5px] leading-[1.55] text-muted"
    >
    </p>
  </nav>
</aside>

<script>
  function initSidebar() {
    const aside = document.querySelector<HTMLElement>("[data-sidebar]");
    const backdrop = document.querySelector<HTMLElement>("[data-sidebar-backdrop]");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
    if (!aside || !backdrop || !openBtn) return;
    if (aside.dataset.ready) return;
    aside.dataset.ready = "1";

    const mq = window.matchMedia("(min-width: 1024px)");
    let open = false;

    function paint() {
      const visible = mq.matches || open;
      aside!.classList.toggle("-translate-x-full", !visible);
      aside!.classList.toggle("invisible", !visible);
      if (visible) aside!.removeAttribute("inert");
      else aside!.setAttribute("inert", "");
      backdrop!.classList.toggle("opacity-0", !visible);
      backdrop!.classList.toggle("pointer-events-none", !visible);
      document.body.classList.toggle("overflow-hidden", !mq.matches && open);
      openBtn!.setAttribute("aria-expanded", String(visible));
    }

    function setOpen(next: boolean) {
      open = next;
      paint();
      if (open) closeBtn?.focus();
      else openBtn?.focus();
    }

    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn?.addEventListener("click", () => setOpen(false));
    backdrop.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setOpen(false);
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((l) =>
      l.addEventListener("click", () => {
        if (!mq.matches) setOpen(false);
      }),
    );

    const nav = aside.querySelector<HTMLElement>("[data-sidebar-nav]");
    const descEl = aside.querySelector<HTMLElement>("[data-active-desc]");
    const descs: Record<string, string> = JSON.parse(nav?.dataset.descs || "{}");
    const syncDesc = (slug?: string) => {
      const raw = slug ?? decodeURIComponent(location.hash.slice(1));
      const key = raw && descs[raw] ? raw : "all";
      if (descEl) descEl.textContent = descs[key] || "";
    };

    document.addEventListener("click", (e) => {
      const el = e.target as HTMLElement | null;
      const link = el?.closest?.("[data-filter-link]") as HTMLElement | null;
      if (link) syncDesc(link.getAttribute("data-filter-link") || undefined);
    });
    window.addEventListener("hashchange", () => syncDesc());

    document.addEventListener("astro:page-load", paint);
    (mq as MediaQueryList).addEventListener("change", paint);
    paint();
    syncDesc();
  }

  initSidebar();
  document.addEventListener("astro:page-load", initSidebar);
</script>
