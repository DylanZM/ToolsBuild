---
import type { Link } from "../data/links";
import { faviconUrl, domainOf } from "../lib/url";
import type { Locale } from "../i18n/ui";

interface Props {
  link: Link;
  locale: Locale;
  index?: number;
}

const { link, locale, index = 0 } = Astro.props;
const href = link.url;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex flex-col gap-3 rounded-xl bg-surface-2 p-4 transition-all duration-300 ease-out-expo hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:p-5"
  data-card
  data-category={link.category}
  data-search-item
  data-preview-url={href}
  data-preview-name={link.name}
  data-name={link.name.toLowerCase()}
  data-desc={link.desc[locale].toLowerCase()}
  data-tags={link.tags.join(" ").toLowerCase()}
>
  <div class="flex items-start justify-between gap-3" data-card-head>
    <div class="flex items-center gap-3 min-w-0">
      <img
        src={faviconUrl(link.url)}
        alt=""
        width="20"
        height="20"
        loading="lazy"
        decoding="async"
        class="h-5 w-5 shrink-0 object-contain"
        data-favicon
        data-fallback={domainOf(link.url).charAt(0).toUpperCase()}
        onerror="this.outerHTML='<span class=&quot;grid h-5 w-5 shrink-0 place-items-center text-[11px] font-medium text-muted&quot;>' + this.dataset.fallback + '</span>'"
      />
      <div class="min-w-0">
        <h3
          class="truncate text-[13px] font-medium tracking-tight text-ink transition-colors"
        >
          {link.name}
        </h3>
        <p class="truncate text-[11px] text-muted">{domainOf(link.url)}</p>
      </div>
    </div>
    <span
      aria-hidden="true"
      class="mt-1 shrink-0 text-muted opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 -translate-x-1"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
      >
    </span>
  </div>

  <p class="text-[12.5px] leading-relaxed text-muted line-clamp-2" data-card-desc>
    {link.desc[locale]}
  </p>

  {
    link.tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-1" data-card-tags>
        {link.tags.slice(0, 3).map((tag) => (
          <span class="rounded-md bg-surface px-2 py-0.5 text-[10.5px] font-medium leading-[1.5] tracking-tight text-muted transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</a>
