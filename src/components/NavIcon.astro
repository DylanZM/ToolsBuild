---
import {
  BookOpen,
  Brain,
  Eye,
  Hammer,
  Layers,
  LayoutGrid,
  Lightbulb,
  Shapes,
  Waves,
  Wrench,
} from "@lucide/astro";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 14, class: cls } = Astro.props;

const ICONS: Record<string, any> = {
  all: Layers,
  inspiration: Lightbulb,
  components: LayoutGrid,
  icons: Shapes,
  motion: Waves,
  visuals: Eye,
  ai: Brain,
  build: Hammer,
  learn: BookOpen,
  utilities: Wrench,
};

const Icon = ICONS[name] ?? Layers;
---

<Icon size={size} stroke-width={1.75} class={cls} />
