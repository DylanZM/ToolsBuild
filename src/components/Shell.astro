---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Sidebar from "./Sidebar.astro";
import type { NavItem } from "./Sidebar.astro";
import SearchPalette from "./react/SearchPalette";
import HoverPreview from "./react/HoverPreview";
import type { Locale } from "../i18n/ui";
import { createT } from "../i18n/ui";
import { categories } from "../data/categories";
import { links, linksByCategory } from "../data/links";
import {
  BookOpen,
  Brain,
  Eye,
  Hammer,
  Layers,
  LayoutGrid,
  Lightbulb,
  Shapes,
  Waves,
} from "lucide";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = createT(locale);

const searchItems = links.map((l) => ({
  id: l.id,
  url: l.url,
  name: l.name,
  category: l.category,
  desc: l.desc[locale],
  tags: l.tags,
}));

const ICONS: Record<string, any> = {
  inspiration: Lightbulb,
  components: LayoutGrid,
  icons: Shapes,
  motion: Waves,
  visuals: Eye,
  ai: Brain,
  build: Hammer,
  learn: BookOpen,
};

const navItems: NavItem[] = [
  {
    slug: "all",
    name: t("nav.all"),
    count: links.length,
    active: true,
    icon: Layers,
  },
  ...categories.map((c) => ({
    slug: c.slug,
    name: c.name[locale],
    count: linksByCategory(c.id).length,
    active: false,
    icon: ICONS[c.id] ?? Lightbulb,
  })),
];
---

<Layout title={title} description={description} locale={locale}>
  <div
    data-sidebar-backdrop
    class="pointer-events-none fixed inset-0 z-40 bg-surface/70 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></div>

  <Header locale={locale} />

  <div class="mx-auto max-w-[1360px] px-5 sm:px-8">
    <slot name="top" />
  </div>

  <div
    class="shell-grid mx-auto grid max-w-[1360px] px-5 sm:px-8 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-11 xl:gap-14"
  >
    <Sidebar locale={locale} items={navItems} />
    <div class="min-w-0">
      <slot />
    </div>
  </div>

  <Footer locale={locale} />

  <SearchPalette client:load items={searchItems} locale={locale} />
  <HoverPreview client:load />
</Layout>

<script>
  function applyFilterFromDom() {
    const grid = document.querySelector<HTMLElement>("[data-filter-grid]");
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-filter-link]"),
    );
    if (!grid || !links.length) return;
    const slugs = new Set(links.map((a) => a.dataset.filterLink || "all"));
    const raw = decodeURIComponent(location.hash.slice(1));
    const slug = raw && slugs.has(raw) ? raw : "all";
    links.forEach((a) => {
      const on = (a.dataset.filterLink || "all") === slug;
      a.dataset.active = on ? "true" : "false";
      if (on) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
    grid
      .querySelectorAll<HTMLElement>("[data-category]")
      .forEach((card) => {
        card.hidden = slug !== "all" && card.dataset.category !== slug;
      });
    if (raw && raw !== slug) {
      history.replaceState(null, "", location.pathname + location.search);
    }
  }

  function setupFilters() {
    const grid = document.querySelector<HTMLElement>("[data-filter-grid]");
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-filter-link]"),
    );
    if (!links.length) return;

    const slugs = new Set(links.map((a) => a.dataset.filterLink || "all"));

    const setActive = (slug: string) => {
      links.forEach((a) => {
        const on = (a.dataset.filterLink || "all") === slug;
        a.dataset.active = on ? "true" : "false";
        if (on) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
    };

    const applyCards = (slug: string) => {
      grid
        ?.querySelectorAll<HTMLElement>("[data-category]")
        .forEach((card) => {
          card.hidden = slug !== "all" && card.dataset.category !== slug;
        });
    };

    let timer = 0;

    links.forEach((a) => {
      if (a.dataset.filterBound) return;
      a.dataset.filterBound = "1";
      a.addEventListener("click", (e) => {
        const slug = a.dataset.filterLink || "all";
        if (!grid || !slugs.has(slug)) return;
        e.preventDefault();
        window.clearTimeout(timer);
        setActive(slug);
        grid.style.opacity = "0";
        timer = window.setTimeout(() => {
          applyCards(slug);
          grid.style.opacity = "1";
          if (!window.matchMedia("(min-width: 1024px)").matches) {
            grid.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }, 150);
        history.replaceState(
          null,
          "",
          location.pathname +
            location.search +
            (slug === "all" ? "" : `#${slug}`),
        );
      });
    });

    applyFilterFromDom();

    if (!(window as any).__filterHashBound) {
      (window as any).__filterHashBound = true;
      window.addEventListener("hashchange", applyFilterFromDom);
    }
  }

  setupFilters();
  document.addEventListener("astro:page-load", setupFilters);
</script>
